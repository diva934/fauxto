# ============================================================================
# Fauxto — variables d'environnement
#
# Copie ce fichier vers .env.local pour le développement, et reporte les mêmes
# clés dans Vercel → Settings → Environment Variables pour la production.
#
# Vérifie ton installation avec :  pnpm diagnose
# ============================================================================


# ── BLOQUANT ────────────────────────────────────────────────────────────────
# Sans ces deux variables, le produit ne génère aucune image.

# Clé de l'API Gemini. https://aistudio.google.com/apikey
# ⚠️ Vérifie aussi que les identifiants de modèle du code existent sur ta clé :
#    `pnpm diagnose` les confronte à l'API et suggère les plus proches si non.
GEMINI_API_KEY=

# Sel du condensé anti-abus. Sert à identifier un visiteur SANS stocker son IP.
# Génère-le une fois, puis ne le change plus : le modifier réinitialise tous les
# quotas de génération gratuite déjà consommés.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FINGERPRINT_SALT=


# ── FORTEMENT RECOMMANDÉ ────────────────────────────────────────────────────
# Le produit tourne sans, mais en mode dégradé documenté dans le README.

# URL publique, sans slash final. Ex : https://fauxto.vercel.app
# Absente, sitemap / images Open Graph / retours Stripe pointent vers localhost.
NEXT_PUBLIC_SITE_URL=

# Supabase. Sans lui : le quota gratuit ne survit pas à un redémarrage, aucune
# purge 24 h n'est possible, et les signalements ne sont pas persistés.
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ Clé service_role : contourne la RLS. JAMAIS côté navigateur, jamais commitée.
SUPABASE_SERVICE_ROLE_KEY=

# Protège /api/cron/purge. Vercel Cron l'envoie en « Authorization: Bearer … ».
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Adresse de contact réelle, affichée sur les pages légales et les signalements.
# Absente, les pages légales affichent « [À COMPLÉTER] » en rouge — c'est voulu.
NEXT_PUBLIC_CONTACT_EMAIL=


# ── PAIEMENT (optionnel jusqu'au premier encaissement) ──────────────────────
# Sans ces clés, le produit reste utilisable en mode « une photo offerte ».

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Obtenu à la création du webhook. Sans lui, un paiement abouti ne crédite RIEN.
# Événement à écouter : checkout.session.completed
# Endpoint : https://TON-DOMAINE/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=


# ── ANTI-ABUS (optionnel, mais requis en production sérieuse) ───────────────
# Sans Upstash, la limitation de débit est en mémoire : chaque instance
# serverless a son propre compteur, donc elle ne limite pratiquement rien.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ── CONFORMITÉ AI ACT (optionnel en test, requis en production) ─────────────
# Sans certificat, les images sont signées avec le certificat de TEST livré par
# c2pa-node : le manifeste est structurellement valide mais marqué NON APPROUVÉ
# par les vérificateurs. Acceptable en développement, pas en production.
# Le PEM doit être collé en une seule valeur, avec des \n littéraux.
C2PA_CERT_PEM=
C2PA_PRIVATE_KEY_PEM=


# ── MESURE D'AUDIENCE (optionnel) ───────────────────────────────────────────
# Plausible ne dépose aucun cookie : c'est pour ça que le site n'affiche
# volontairement AUCUN bandeau de consentement. Ne le remplace pas par une
# solution à cookies sans ajouter le bandeau correspondant.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=


# ── SURCHARGE DE MODÈLE (optionnel — laisser vide) ──────────────────────────
# Permet de corriger un identifiant de modèle sans redéployer de code.
# Défaut : gemini-3.6-flash (stable, vérifié le 30/07/2026 contre le catalogue
# officiel). L'ancien défaut `gemini-3.1-flash` n'existait pas, ce qui faisait
# refuser 100 % des générations puisque la modération est fail-closed.
# Bascule possible : gemini-3.5-flash-lite (5× moins cher en entrée, mais moins
# précis sur l'estimation d'âge — un faux refus coûte un client).
GEMINI_MODERATION_MODEL=


# ── IDENTITÉ LÉGALE (obligatoire avant d'encaisser le premier euro) ─────────
# Ces valeurs ne peuvent pas être inventées : un SIRET ou une adresse fictifs
# sur des mentions légales constituent une fausse déclaration. Tant qu'elles
# sont vides, les pages légales affichent « [À COMPLÉTER] » en rouge vif.
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
NEXT_PUBLIC_LEGAL_FORM=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_SIRET=
NEXT_PUBLIC_LEGAL_VAT=
NEXT_PUBLIC_LEGAL_PUBLISHER=

# Adresses autorisees sur /admin/partenaires, separees par des virgules.
# Sans cette variable, la page renvoie 404.
ADMIN_EMAILS=
